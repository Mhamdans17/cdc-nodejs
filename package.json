{
  "name": "node_cdc_monorepo",
  "version": "1.0.0",
  "description": "Combined CDC Service and Consumer project with shared dependencies",
  "main": "index.js",
  "scripts": {
    "start:service": "node cdc-service/index.js",
    "start:consumer": "node consumer/consumer.js",
    "dev:service": "nodemon cdc-service/index.js",
    "dev:consumer": "nodemon consumer/consumer.js",
    "start:all": "npm-run-all --parallel start:service start:consumer"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "dotenv": "^16.4.0",
    "ioredis": "^5.8.0",
    "kafkajs": "^2.2.4",
    "mysql2": "^3.15.1",
    "zongji": "github:nevill/zongji"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "npm-run-all": "^4.1.5"
  }
}
